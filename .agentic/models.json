{
  "$schema": "./schemas/models.schema.json",
  "lastReviewed": "2026-09-18",
  "executionDeclaration": {"fileName": "run.yaml", "location": "runs/<version>/<slug>/run.yaml", "scope": "Selección mínima previa a spec.md: modelo, variante y fallback."},
  "validVariants": ["default", "none", "minimal", "low", "medium", "high", "xhigh", "max"],
  "fallbackAliases": {},
  "providers": {},
  "roleAliases": {"analyst-agent": "planner", "builder-agent": "builder", "reviewer-agent": "reviewer", "qa-agent": "reviewer", "code-reviewer-agent": "reviewer"},
  "routing": {
    "defaultSdd": "STANDARD",
    "depthWeights": {"LIGHT": {"quality": 1, "cost": 3, "latency": 2}, "STANDARD": {"quality": 2, "cost": 1, "latency": 1}, "FULL": {"quality": 4, "cost": 0, "latency": 0}},
    "roleCapabilities": {"planner": ["reasoning", "context", "planning"], "builder": ["coding", "tools", "debugging"], "reviewer": ["reasoning", "review", "independence"]},
    "implementations": []
  },
  "roles": {
    "planner": {"default": {"model": "default", "variant": "default"}, "fallback": []},
    "builder": {"default": {"model": "default", "variant": "default"}, "fallback": []},
    "reviewer": {"default": {"model": "default", "variant": "default"}, "fallback": []}
  }
}
