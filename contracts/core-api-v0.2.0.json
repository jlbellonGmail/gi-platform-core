{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gi-platform.invalid/contracts/core-api-v0.2.0.json",
  "title": "GI Platform Core identity contract",
  "description": "Additive CoreApi v0.2.0 identity resolution and link operations.",
  "version": "0.2.0",
  "compatible_with": ["0.1.0"],
  "type": "object",
  "required": ["contract_version", "operations", "errors", "invariants"],
  "properties": {
    "contract_version": {"const": "0.2.0"},
    "compatible_with": {"type": "array", "items": {"const": "0.1.0"}},
    "operations": {"type": "array", "minItems": 3, "items": {"type": "object", "required": ["name", "purpose", "authorization", "response"], "properties": {"name": {"type": "string"}, "purpose": {"type": "string"}, "authorization": {"type": "string"}, "response": {"type": "string"}}, "additionalProperties": false}},
    "errors": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["code", "status"], "properties": {"code": {"type": "string"}, "status": {"type": "integer"}}, "additionalProperties": false}},
    "invariants": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": false
}
